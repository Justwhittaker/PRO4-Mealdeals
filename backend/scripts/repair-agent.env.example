# Copy to repair-agent.env on the NUC (chmod 600). Do NOT commit repair-agent.env.

# From @BotFather → /newbot → paste token
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user id (get from @userinfobot). Comma-separated for multiple.
TELEGRAM_ALLOWED_USER_IDS=

# Paths on the NUC
MEALDEALS_BACKEND_DIR=/home/justinw/MealDeals/backend
# Repo root for /pull and /deploy (parent of backend when clone is ~/MealDeals)
MEALDEALS_REPO_DIR=/home/justinw/MealDeals
COMPOSE_FILE=docker-compose.nuc.yml
CONTAINER=mealdeals-celery-nuc

# Git allowlist for /pull and /deploy (never user-supplied)
GIT_REMOTE=origin
GIT_BRANCH=master

# Rate limits (seconds)
RESTART_COOLDOWN_SECS=300
PULL_COOLDOWN_SECS=120

# Optional: same topic as nuc-health.env — ack on /restart and /pull
# NTFY_TOPIC=dineadeal-nuc-REPLACE_ME
# NTFY_URL=https://ntfy.sh
# NTFY_TOKEN=

# /logs tail size
LOG_TAIL_LINES=40
