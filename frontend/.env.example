# App
NEXT_PUBLIC_APP_URL=https://dineadeal.com
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only API base (Vercel → public API). Falls back to NEXT_PUBLIC_API_URL.
API_URL=http://localhost:8000

# NextAuth
NEXTAUTH_URL=https://dineadeal.com
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe — Priority: free month (card) → monthly (geo currency); pay-now 50% off 3 months
# Prices are auto-created via lookup keys when missing. Optional overrides:
STRIPE_PRODUCT_PRIORITY_ID=
STRIPE_PRICE_PRIORITY_MONTHLY_EUR=price_1U1XhNIFzPFZzgCPPCqV28vX
STRIPE_PRICE_PRIORITY_PROMO_EUR=
# Legacy intro price (unused by new flow; kept for old schedules)
STRIPE_PRICE_PRIORITY_INTRO_EUR=price_1U1XhLIFzPFZzgCPUEmzcT7c
# One-time Design Special — €20 per deal (slot-exempt, 60 days)
STRIPE_PRICE_DESIGN_SPECIAL_EUR=price_1U1XrbIFzPFZzgCPuc4R4rfO
# Shared secret for design fulfill + inbound email auto-post
DESIGN_FULFILL_SECRET=mealdeals-design

# Public contact email (free-trial abuse / billing support)
NEXT_PUBLIC_CONTACT_EMAIL=hello@dineadeal.com

# Backend SMTP for Friday weekly specials is configured on the API (.env):
# FRONTEND_BASE_URL=https://dineadeal.com, SMTP_*, SMTP_FROM_EMAIL=noreply@dineadeal.com

# Google AdSense (next-google-adsense)
# Live site: https://dineadeal.com — AdSense will not approve localhost.
# Connect:
#   1. AdSense → Sites → Add site → dineadeal.com
#   2. Set NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=pub-XXXXXXXXXXXXXXXX
#   3. Set NEXT_PUBLIC_ADSENSE_ENABLED=true and NEXT_PUBLIC_APP_URL=https://dineadeal.com
#   4. Deploy — build writes public/ads.txt + loads Auto ads (or manual slots below)
# Until publisher ID is set, UI keeps reserved placeholders (no AdSense script).
NEXT_PUBLIC_ADSENSE_ENABLED=true
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=pub-xxxxxxxxxxxxxxxx
# Legacy alias still accepted (ca-pub-…); prefer PUBLISHER_ID above
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional manual units (skip for Auto ads on first connect)
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# Optional in-feed layout key from AdSense unit code
NEXT_PUBLIC_ADSENSE_INFEED_LAYOUT_KEY=-fb+5w+4e-db+86
# Set true only if you intentionally want ads on *.vercel.app previews
NEXT_PUBLIC_ADSENSE_ALLOW_VERCEL_PREVIEW=false
