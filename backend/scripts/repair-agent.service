[Unit]
Description=MealDeals NUC Telegram repair bot (slash commands, no LLM)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/MealDeals/backend/scripts
Environment=REPAIR_AGENT_ENV=%h/MealDeals/backend/scripts/repair-agent.env
ExecStart=%h/MealDeals/backend/scripts/.venv-repair/bin/python -m repair_agent.bot
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
