# Copy to nuc-health.env on the NUC (do not commit nuc-health.env).
# Pick an unguessable topic, e.g. dineadeal-nuc-$(openssl rand -hex 8)

NTFY_TOPIC=dineadeal-nuc-REPLACE_ME

# Optional — defaults shown
# NTFY_URL=https://ntfy.sh
# NTFY_TOKEN=
# CHECK_CELERY=1
# REMINDER_HOURS=1
# CONTAINER=mealdeals-celery-nuc

# Also copy NTFY_TOPIC (and optional NTFY_URL / NTFY_TOKEN) into backend/.env so
# the Celery container can send twice-daily scrape cycle digests at 05:50/17:50 UTC.
