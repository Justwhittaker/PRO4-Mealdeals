APP_NAME=Dine A Deal API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
HOST=0.0.0.0
PORT=8000

# Async SQLAlchemy / asyncpg
DATABASE_URL=postgresql+asyncpg://mealdeals:mealdeals@postgres:5432/mealdeals
# Sync URL for Alembic + Celery workers
DATABASE_URL_SYNC=postgresql://mealdeals:mealdeals@postgres:5432/mealdeals

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Affiliate network tags (regional overrides)
AMAZON_ASSOCIATE_TAG=mealdeals-20
BOOKING_AID=000000
AWIN_PUBLISHER_ID=000000
CJ_WEBSITE_ID=000000
IMPACT_CAMPAIGN_ID=000000
RAKUTEN_MID=000000

CURRENCY_CACHE_TTL=3600
CLICK_LOG_TTL=604800
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://dineadeal.com,https://www.dineadeal.com
DESIGN_FULFILL_SECRET=mealdeals-design

# Staff admin portal — must match frontend ADMIN_API_KEY (sent as X-Admin-Key)
ADMIN_API_KEY=dev-admin-key-change-me

# Public site URL used in weekly special emails / unsubscribe links
FRONTEND_BASE_URL=https://dineadeal.com

# Resend HTTPS API (preferred on Render free — outbound SMTP is blocked there)
# Create a key at https://resend.com — verify just.whittaker@gmail.com or dineadeal.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Dine A Deal <onboarding@resend.dev>

# SMTP fallback (works locally; on Render set SMTP_ALLOW=true only on a paid instance)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@dineadeal.com
SMTP_USE_TLS=true
SMTP_ALLOW=false

# Inbox for public contact form submissions
CONTACT_TO_EMAIL=just.whittaker@gmail.com
