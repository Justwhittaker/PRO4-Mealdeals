# Copy to backend/.env on the always-on NUC:
#   cp .env.nuc.example .env
#
# Render → dineadeal-db / dineadeal-redis → Connect → use *External* URLs only.
# Do not commit .env.

APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-long-random-string

# Postgres (External Database URL from Render — must include ?sslmode=require)
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL_SYNC=postgresql://USER:PASS@HOST/DB?sslmode=require

# Redis (External connection string from Render Key Value)
REDIS_URL=rediss://...
CELERY_BROKER_URL=rediss://...
CELERY_RESULT_BACKEND=rediss://...

FRONTEND_BASE_URL=https://dineadeal.com
REVALIDATE_SECRET=

# Optional — only if direct Overpass mirrors fail on the NUC (overpass-api.de often blocked).
# Test first: curl -m 15 -X POST https://overpass.openstreetmap.fr/api/interpreter -d 'data=[out:json];node(1);out;'
# If that works, leave OVERPASS_PROXY_URL unset for faster scrapes.
# OVERPASS_PROXY_URL=https://dineadeal-api.onrender.com/api/v1/scrapers/internal/overpass

# Scrape tuning (NUC primary scheduler — no GitHub Actions scrape cron)
DEEP_SCRAPE_ENABLED=true
DEEP_SCRAPE_MAX_EXTRA_FETCHES=4

# Weekly email stays on GitHub Actions — keep false on NUC to avoid duplicate sends
CELERY_WEEKLY_EMAIL_ENABLED=false
SCRAPED_DEAL_TTL_DAYS=14

# Optional — contact form uses Render API Resend, not NUC
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Dine A Deal <onboarding@resend.dev>
